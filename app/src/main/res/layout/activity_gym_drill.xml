<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:theme="@style/ToolbarStyle"
        app:popupTheme="@style/AppTheme.PopupOverlay">

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/gymReviewSwitch"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:gravity="center_vertical"
            android:minWidth="112dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/gym_advance_auto"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="14sp"
            app:showText="false"
            app:switchPadding="8dp" />
    </androidx.appcompat.widget.Toolbar>

    <LinearLayout
        android:id="@+id/gymDrillHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/gymDrillAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/gymDrillStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/gymNextQuestion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gym_next_question"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Use the full game's arrangement. The include ID replaces its root main_content ID. -->
    <include
        android:id="@+id/gymGameContent"
        layout="@layout/content_game_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="0dp"
        android:layout_weight="1"
        tools:ignore="DuplicateIncludedIds" />

    <include
        android:id="@+id/gymQuizResults"
        layout="@layout/gym_quiz_results"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone" />
</LinearLayout>
